# ---------------------------------------------------------------
# Compiled MQL binaries - regenerated by MetaEditor on every build.
# Never commit these to the working tree; attach them to a GitHub
# Release instead if you want distributable builds.
# ---------------------------------------------------------------
*.ex4
*.ex5

# ---------------------------------------------------------------
# MetaTrader terminal noise. If you ever version the whole MQL4
# data folder rather than just your source, these are the folders
# that will otherwise fill your repo with junk.
# ---------------------------------------------------------------
Logs/
logs/
*.log
Files/
Images/
Presets/
tester/
*.htm
*.html
*.gif
*.set
*.opt
*.fxt
*.hst

# ---------------------------------------------------------------
# Anything with account credentials or broker connection details.
# ---------------------------------------------------------------
*.ini
config/
Config/
accounts.dat
secrets/

# ---------------------------------------------------------------
# macOS / editor cruft
# ---------------------------------------------------------------
.DS_Store
.vscode/
.idea/
*.swp
